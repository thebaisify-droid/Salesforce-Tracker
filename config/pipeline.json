{
  "timezone": "Europe/London",
  "scheduled_local_time": "07:15",
  "lookback_hours": 72,
  "state_dir": "state",
  "runs_dir": "runs",
  "strict_mode": true,
  "require_metrics_report": true,
  "require_quality_report": true,
  "min_sources_succeeded": 3,
  "sources": [
    {"name":"source_1","enabled":true,"config":"config/sources/source_1.json","output":"source_1.json","command":"python collectors/source_1.py --incremental --since {since} --until {until} --output {output}"},
    {"name":"source_2","enabled":true,"config":"config/sources/source_2.json","output":"source_2.json","command":"python collectors/source_2.py --incremental --since {since} --until {until} --output {output}"},
    {"name":"source_3","enabled":true,"config":"config/sources/source_3.json","output":"source_3.json","command":"python collectors/source_3.py --incremental --since {since} --until {until} --output {output}"}
  ],
  "steps": {
    "transform": "python scripts/process_incremental.py --input-dir {raw_dir} --run-id {run_id} --metrics {metrics}",
    "quality": "python scripts/validate_incremental.py --run-id {run_id} --report {quality_report}",
    "publish": "python scripts/publish_dashboard.py --run-id {run_id}"
  },
  "assurance": {
    "expected_master_data_version": "1.3",
    "expected_role_taxonomy_version": "2.2",
    "max_rejection_rate": 0.15
  }
}
