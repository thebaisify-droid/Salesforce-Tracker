{
  "timezone": "Europe/London",
  "scheduled_local_time": "07:15",
  "lookback_hours": 48,
  "state_dir": "state",
  "runs_dir": "runs",
  "strict_mode": true,
  "require_metrics_report": true,
  "require_quality_report": true,
  "min_sources_succeeded": 3,
  "sources": [
    {
      "name": "source_1",
      "enabled": true,
      "config": "config/sources/source_1.json",
      "output": "source_1.json",
      "command": "python -m collectors.source_1 --incremental --since {since} --until {until} --output {output}"
    },
    {
      "name": "source_2",
      "enabled": true,
      "config": "config/sources/source_2.json",
      "output": "source_2.json",
      "command": "python -m collectors.source_2 --incremental --since {since} --until {until} --output {output}"
    },
    {
      "name": "source_3",
      "enabled": true,
      "config": "config/sources/source_3.json",
      "output": "source_3.json",
      "command": "python -m collectors.source_3 --incremental --since {since} --until {until} --output {output}"
    },
    {
      "name": "source_4",
      "enabled": true,
      "config": "config/sources/source_4.json",
      "output": "source_4.json",
      "command": "python -m collectors.source_4 --incremental --since {since} --until {until} --output {output}"
    },
    {
      "name": "source_5",
      "enabled": true,
      "config": "config/sources/source_5.json",
      "output": "source_5.json",
      "command": "python -m collectors.source_5 --incremental --since {since} --until {until} --output {output}"
    }
  ],
  "steps": {
    "transform": "python -m scripts.process_incremental --input-dir {raw_dir} --run-id {run_id} --metrics {metrics}",
    "quality": "python -m scripts.validate_incremental --run-id {run_id} --report {quality_report}",
    "publish": "python -m scripts.publish_dashboard --run-id {run_id}",
    "lifecycle": "python -m scripts.verify_lifecycle --report {lifecycle_report} --metrics {metrics} --min-age-days 14 --limit 20 --confirmations 2 --min-confirmation-hours 12"
  },
  "assurance": {
    "expected_master_data_version": "1.4",
    "expected_role_taxonomy_version": "2.2",
    "max_rejection_rate": 0.15,
    "lifecycle": {
      "enabled": true,
      "min_age_days": 14,
      "daily_check_limit": 20,
      "confirmations_required": 2,
      "min_confirmation_hours": 12,
      "policy": "No vacancy is expired from search absence alone. Two explicit unavailable checks are required."
    }
  },
  "required_sources": [
    "source_1",
    "source_2",
    "source_3"
  ],
  "apify_budget": {
    "monthly_usd": 19,
    "account_limit_required": true,
    "accounting": "Strict $19 shared Apify account ceiling; $8 Salesforce reserve and $11 BA allowance. Check actual account limit and usage before any paid Actor. BA acquisition currently paused."
  }
}
