{
  "ready": true,
  "provider": "apify_actor",
  "source_name": "JobServe",
  "role": "secondary_enrichment_uk_job_board",
  "actor_id": "santamaria-automations/jobserve-uk-scraper",
  "token": "env:APIFY_TOKEN",
  "timeout_seconds": 600,
  "window_field": "posted_at",
  "input": {
    "searchQueries": [
      "salesforce"
    ],
    "location": "",
    "radius": 20,
    "jobType": "",
    "maxItems": 75,
    "maxResultsPerQuery": 200,
    "maxJobsPerCompany": 0,
    "includeJobDetails": true,
    "includeCompanyDetails": false,
    "maxConcurrency": 4
  },
  "notes": "JobServe UK enrichment source. UK-wide Salesforce search with detail enrichment; non-blocking because only source_1/source_2/source_3 are required.",
  "max_charged_results": 75
}
